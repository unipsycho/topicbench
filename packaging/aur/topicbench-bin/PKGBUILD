# Maintainer: Agile Automation <mike@agileautomation.ca>
# Binary package of TopicBench (OSS) from GitHub Releases.
# Installs the Release topicbench-linux-x64 ELF to /usr/bin with .desktop +
# icon, using system libxcb / libxkbcommon / Vulkan|GL.

pkgname=topicbench-bin
pkgver=1.2.6
pkgrel=1
pkgdesc='Multi-broker MQTT explorer and monitor (prebuilt binary)'
arch=('x86_64')
url='https://github.com/unipsycho/topicbench'
license=('MIT' 'Apache-2.0')
depends=(
  'libxcb'
  'libxkbcommon'
  'libxkbcommon-x11'
  'wayland'
  'vulkan-icd-loader'
  'dbus'
)
optdepends=(
  'mesa: OpenGL / Vulkan ICD for GPU rendering'
  'libsecret: store MQTT credentials in the OS keyring'
)
provides=('topicbench')
conflicts=('topicbench')
options=('!strip' '!debug')
source=(
  "topicbench-linux-x64-${pkgver}::https://github.com/unipsycho/topicbench/releases/download/v${pkgver}/topicbench-linux-x64"
  'topicbench.desktop'
  'topicbench.png'
  'LICENSE-MIT'
  'LICENSE-APACHE'
)
sha256sums=(
  '1d7f8414d2bff399bbc964eec5c3463da0639150741b0817891cb1e09f36242c'
  '7c3af11fb2781448a81c4210b41325dd2a775e1c3322bda26e36e5a34832cc33'
  'fb0aaca839bc2d5095faa2a28ad43bd02982ad880a28fbcadd1b79a7b10fdf76'
  'cfd9aa40af9d85ca63ef620485aeda7afa16b8ef75ece0b784ccb45bf4490eb3'
  'cfc7749b96f63bd31c3c42b5c471bf756814053e847c10f3eb003417bc523d30'
)

package() {
  install -Dm755 "topicbench-linux-x64-${pkgver}" "${pkgdir}/usr/bin/topicbench"
  install -Dm644 topicbench.desktop \
    "${pkgdir}/usr/share/applications/topicbench.desktop"
  install -Dm644 topicbench.png \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/topicbench.png"
  install -Dm644 topicbench.png \
    "${pkgdir}/usr/share/pixmaps/topicbench.png"
  install -Dm644 LICENSE-MIT \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-APACHE"
}
